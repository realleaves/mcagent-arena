# Copy to .env. Never commit real credentials.
# Demo works without MCP or model credentials.
MCD_MCP_URL=https://mcp.mcd.cn
MCD_MCP_TOKEN=
DATABASE_URL=./data/arena.sqlite
API_PORT=3001
WEB_PORT=5173
AGENT_A_API_BASE_URL=https://api.deepseek.com/v1
AGENT_A_API_KEY=
AGENT_A_MODEL=
AGENT_B_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AGENT_B_API_KEY=
AGENT_B_MODEL=

# Optional: chat or responses; gpt-6.1-sol automatically selects responses.
AGENT_A_API_PROTOCOL=chat
AGENT_B_API_PROTOCOL=responses
AGENT_A_MAX_OUTPUT_TOKENS=4000
AGENT_B_MAX_OUTPUT_TOKENS=4000
AGENT_A_TEMPERATURE=0
AGENT_B_TEMPERATURE=0
AGENT_A_REASONING_EFFORT=low
AGENT_B_REASONING_EFFORT=low
# Set after creating your own public repository.
GITHUB_URL=
